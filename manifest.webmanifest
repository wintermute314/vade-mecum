{
  "id": "./",
  "name": "Vade Mecum",
  "short_name": "Vade Mecum",
  "description": "Persoonlijke reisgids, volledig offline.",
  "lang": "nl",
  "start_url": "./#/start",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#faf7f2",
  "theme_color": "#7a3b2e",
  "share_target": {
    "action": "./gedeeld",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "reis", "accept": ["application/json", "text/plain", "application/octet-stream", ".json"] }] }
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
