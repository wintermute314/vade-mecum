{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reisdb.schema.json",
  "title": "Reisdatabase (reisdb) 1.x",
  "type": "object",
  "required": ["format", "schemaVersion", "trip", "entities"],
  "properties": {
    "format": { "const": "reisdb" },
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "modules": { "type": "array", "items": { "type": "string" } },
    "trip": {
      "type": "object",
      "required": ["id", "title", "start", "end"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" },
        "timezone": { "type": "string" },
        "intro": { "type": "string" }
      }
    },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "attachments": { "type": "array", "items": { "$ref": "#/$defs/attachment" } }
  },
  "$defs": {
    "isoish": { "type": "string", "pattern": "^-?[0-9]{1,4}(-[0-9]{2}(-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?)?)?)?$" },
    "entity": {
      "type": "object",
      "required": ["id", "type", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" },
        "text": { "type": "string" },
        "attrs": { "type": "object" },
        "when": { "type": "object", "properties": { "start": { "$ref": "#/$defs/isoish" }, "end": { "$ref": "#/$defs/isoish" } } },
        "circa": { "type": "boolean" },
        "geo": { "type": "object", "required": ["lat", "lng"], "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } } },
        "address": { "type": "string" },
        "maps": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "attachments": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string" },
        "why": { "type": "string" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
        "codes": { "type": "array", "items": { "type": "object", "required": ["value"], "properties": { "label": { "type": "string" }, "value": { "type": "string" }, "format": { "enum": ["qr", "tekst"] } } } },
        "sensitive": { "type": "array", "items": { "type": "string" } }
      }
    },
    "relation": {
      "type": "object",
      "required": ["from", "type", "to"],
      "properties": {
        "from": { "type": "string" }, "type": { "type": "string" }, "to": { "type": "string" },
        "attrs": { "type": "object" }, "note": { "type": "string" }
      }
    },
    "attachment": {
      "type": "object",
      "required": ["id", "title", "mime", "data"],
      "properties": {
        "id": { "type": "string" }, "title": { "type": "string" }, "mime": { "type": "string" },
        "filename": { "type": "string" }, "data": { "type": "string" }
      }
    }
  }
}
